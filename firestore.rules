rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════ دوال مساعدة ═══════════
    function hasRole() {
      return request.auth != null
        && request.auth.token.role != null
        && request.auth.token.role != '';
    }
    function isViewer() {
      return request.auth != null
        && request.auth.token.role == 'viewer';
    }
    // مُصادَق (يشمل المجهول) — يستخدمه تطبيق الفنيين
    function isSignedIn() {
      return request.auth != null;
    }
    function role()          { return request.auth.token.role; }
    function isAdmin()       { return hasRole() && role() == 'admin'; }
    function anyRole(list)   { return hasRole() && role() in list; }
    // الحقولُ التي لا يجوز أن يمسّها التعديل — تُقارَن بفارق الوثيقتين لا حقلاً حقلاً
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    /* ═══════════ مجموعاتُ التعاقدات المقفلة (المرحلة ٦) ═══════════
       القاعدةُ العامة أدناه تسمح لأيّ دورٍ غيرِ الزائر بالكتابة في كلّ شيء. ولأنّ
       قواعدَ Firestore تُقيَّم بـ«أو» — يكفي تطابقُ قاعدةٍ واحدةٍ للسماح — فإضافةُ
       قواعدَ صارمةٍ لهذه المجموعات **لا تقيّد شيئاً** ما لم تُستثنَ من العامة أوّلاً.
       فهذه القائمةُ هي الاستثناء، وكلُّ مجموعةٍ فيها يحكمها بلوكُها وحدَه. */
    function ctrLocked(coll) {
      return coll in [
        'global_vendors',            'global_vendors_dev',
        'global_contract_requests',  'global_contract_requests_dev',
        'global_contracts',          'global_contracts_dev',
        'global_contract_extracts',  'global_contract_extracts_dev',
        'global_contract_changes',   'global_contract_changes_dev'
      ];
    }

    /* ═══════════ حساباتُ المستخدمين — البند C1 ═══════════
       `meta/users` و`meta/{proj}_users` (ونسختاهما `_dev`) مستنداتٌ تحمل `hash`
       و`role` و`permissions` — **ومنها يُصادِق الـWorker ويُصدر التوكِن**. فكتابتُها
       ليست كتابةَ بياناتٍ بل **إصدارُ صلاحية**: مَن يكتب فيها يضيف لنفسه حساباً
       بدور `admin` ثم يدخل به، فيصير أدمن على المنصّة كلِّها بلا أن يمرّ على أحد.
       والقاعدةُ العامةُ أدناه كانت تمنح ذلك **لكلّ دورٍ غيرِ الزائر** — مراقبٌ أو
       مسؤولُ مستودعٍ يفتح الـConsole ويكتب المستندَ مباشرةً.

       فتُستثنى هنا من العامة (وإلّا لم يقيّد القفلُ شيئاً — القواعدُ تُقيَّم بـ«أو»)،
       ويحكمها بلوكُها وحدَه: **الكتابةُ للأدمن لا غير**.
       **والقراءةُ لم تُمَسّ**: تبقى لكلّ ذي دورٍ من القاعدة العامة كما كانت — الشاشةُ
       تعرض قائمةَ المستخدمين لمن يراها، والتضييقُ هنا على مَن **يغيّر** لا مَن يقرأ. */
    function isUsersDoc(coll, doc) {
      return coll == 'meta' && doc.matches('(.*_)?users(_dev)?');
    }
    match /meta/{doc} {
      allow write: if isAdmin() && doc.matches('(.*_)?users(_dev)?');
    }

    /* ═══════════ طابورُ واتساب — للخادم وحدَه (البند M16) ═══════════
       `wa_outbox` ليس مجموعةَ بيانات بل **قناةَ إرسالٍ باسم الشركة**: كلُّ مستندٍ
       يُنشأ فيه يلتقطه `waSender` ويرسله رسالةً رسميةً من رقمها. فمن يكتب فيه
       يكتب `to` و`params` كما يشاء — أيُّ نصٍّ إلى أيّ جوّالٍ في العالم بصوت
       الشركة. و`wa_log` أرشيفُه (أرقامٌ ونصوصُ رسائلَ للجميع).

       والكاتبُ الشرعيُّ **دوالُّ السحابة وحدَها** بـAdmin SDK — وهو **يتجاوز
       القواعدَ كلَّها**، فقفلُها تماماً لا يعطّل شيئاً. وتحقّقنا: لا موضعَ واحدٌ
       في `index.html` ولا في الوحدات يقرأ هاتين المجموعتين أو يكتب فيهما.
       **والقراءةُ تبقى مفتوحةً لذوي الأدوار** — حاولتُ قفلَها فأسقطتُ النظامَ كلَّه
       (انظر التحذير في القاعدة العامة أدناه). قفلُها يحتاج بلوكاً مستقلّاً بـ`list`
       لا شرطاً في العامة — بندٌ مستقلٌّ لاحق. **المقفولُ هنا: الكتابةُ**، وهي
       جوهرُ M16 (الحقنُ لا التلصّص). */
    function srvOnly(coll) {
      return coll in ['wa_outbox', 'wa_log'];
    }
    // القراءةُ تبقى من القاعدة العامة (لكلّ ذي دور) — قفلُها يمرّ بشرطٍ على المسار
    // في قاعدة القراءة، وذاك يُسقط استعلامَ كلّ مجموعة. **الكتابةُ هي المقفولة.**
    match /wa_outbox/{doc} { allow write: if false; }
    match /wa_log/{doc}    { allow write: if false; }

    /* ═══════════ سجلُّ التدقيق — يُضاف ولا يُعدَّل ولا يُمحى (البند M11) ═══════════
       القاعدةُ السابقة `allow read, write: if hasRole()` كانت تمنح **التعديلَ
       والحذفَ** لكلّ ذي دورٍ — و`write` تشمل الثلاثة. فالسجلُّ الذي يُفترض أن يشهد
       على الفعل كان يمحوه فاعلُه. (والقاعدةُ العامة تمنح المثلَ، فلا يكفي إصلاحُ
       هذا البلوك وحدَه.)

       **والدورُ المكتوبُ يُقيَّد بدور التوكِن**: `logAudit` يكتب `role` من
       `currentUser` — وهو نصٌّ في المتصفّح. فمن يكتب مباشرةً يوقّع القيدَ بدورٍ
       ليس دورَه. الآن لا يُقبل إلا دورُ التوكِن نفسُه، أو `-` (قيدُ النظام حين لا
       مستخدمَ بعد). **وتطبيقُ الفنيين مُستثنًى** لأنه بلا دورٍ أصلاً (مُصادَقٌ
       مجهولاً، ويكتب `role:"فني"`) — يُغلق ذلك مع C2 لا قبلَه. */
    /* ⚠ `request.auth.token.role` على توكِنٍ **لا يحمل الحقل أصلاً** (الفنّيُّ
       المُصادَقُ مجهولاً) ليس «فارغاً» بل **خطأُ تقييم**، والخطأُ يسري في التعبير
       كلِّه فيُردّ الطلب. فـ`!hasRole()` بدت صحيحةً ومنعت الفنّيَّ من الكتابة —
       رصدها الفحصُ لا القراءة. القاعدة: على التوكِن استعمل `get(key, default)`
       لا الوصولَ المباشر، تماماً كما نفعل مع `resource.data`. */
    function tokRole() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }
    function auditRoleOk() {
      return tokRole() == ''
          || request.resource.data.get('role', '') in [tokRole(), '-'];
    }
    match /audit_log/{doc} {
      // القراءةُ والإضافةُ كما كانتا — تطبيقُ الفنيين يقرأ السجلَّ ويكتب فيه
      allow read:           if isSignedIn();
      allow create:         if isSignedIn() && auditRoleOk();
      allow update, delete: if false;
    }
    match /audit_log_dev/{doc} {
      allow read:           if hasRole();
      allow create:         if hasRole() && auditRoleOk();
      allow update, delete: if false;
    }
    function isAuditColl(coll) {
      return coll in ['audit_log', 'audit_log_dev'];
    }

    // ═══════════ القاعدة العامة (النظام الرئيسي) ═══════════
    // القراءةُ كما كانت لكلّ ذي دور. **والقصدُ من إبقائها مفتوحةً هنا مقصود**:
    // تقييدُ القراءة يجعل جدولَ الموازنة يعرض أصفاراً صامتةً لمن لا يملكها بدل رفضٍ
    // ظاهر — ورقمٌ خاطئٌ أسوأُ من بابٍ مغلق. تضييقُ القراءة خطوةٌ مستقلّةٌ لاحقة.
    match /{document=**} {
      /* ⛔ **لا تضع شرطاً على `document[…]` في قاعدة القراءة.** (انقطاعُ إنتاجٍ
         حقيقيّ — v18.9.2635.) كتبتُ هنا `hasRole() && !srvOnly(document[0])`
         لأستثني طابورَ واتساب من القراءة، فسقط **استعلامُ كلّ مجموعةٍ في النظام**:
         الشاشاتُ كلُّها «Missing or insufficient permissions» والأدمن داخلٌ بدوره.
         **والسببُ أنّ `read` عمليتان لا واحدة**: `get` لمستندٍ بعينه — ويعمل —
         و`list` لاستعلام مجموعة. وفي الـ`list` لا مستندَ بعدُ، فمقاطعُ المسار
         غيرُ محسومة، وأيُّ شرطٍ عليها يسقط. الكتابةُ لا تُصاب بهذا (لا `list` فيها)
         ولذلك عملت `ctrLocked(document[0])` سنواتٍ بلا أثر.
         ولإخراج مجموعةٍ من القراءة: بلوكٌ مستقلٌّ لها، لا شرطٌ في العامة. */
      allow read:  if hasRole();
      allow write: if hasRole() && !isViewer() && !ctrLocked(document[0])
                      && !isUsersDoc(document[0], document[1])
                      && !srvOnly(document[0])
                      && !isAuditColl(document[0]);
    }

    // ═══════════ إضافات تطبيق الفنيين (مصادقة مجهولة، مرحلة اختبار) ═══════════
    // الإصلاح النهائي قبل التشغيل الحقيقي = دخول الفنيين بـ Custom Token بدور
    // 'technician' ثم تقييد القواعد بالدور (Phase 3).

    // البلاغات (الأمانة): قراءة + تحديث فقط
    match /hail_tickets/{doc} {
      allow read, update: if isSignedIn();
    }

    // الحضور والانصراف
    match /attendance/{doc} {
      allow read, write: if isSignedIn();
    }

    // الفنيون (PIN): قراءة + كتابة (تغيير PIN من لوحة أدمن التطبيق)
    match /technicians/{doc} {
      allow read, write: if isSignedIn();
    }

    // مستندات meta التي يقرأها/يعدّلها التطبيق فقط (لا نفتح meta كاملة)
    match /meta/settings       { allow read:        if isSignedIn(); }
    match /meta/ai_settings     { allow read:        if isSignedIn(); }
    match /meta/ppm_checklists  { allow read, write: if isSignedIn(); }

    // ─────────── جديد (tech-app v5.22): مُنتقي المشروع ───────────
    // (1) قائمة المشاريع — يقرؤها المُنتقي لبناء القائمة المنسدلة.
    match /meta/projects { allow read: if isSignedIn(); }

    // (2) إعدادات كل مشروع (workTypes/buildings/supervisors) — أي مستندٍ في مجموعة
    //     meta ينتهي اسمه بـ "_settings" (مثل bathroom001_settings). لا يشمل
    //     المستندات الحسّاسة الأخرى (counter/…): الشرط يقصره على *_settings فقط.
    match /meta/{doc} {
      allow read: if isSignedIn() && doc.matches('.*_settings');
    }

    // (3) بلاغات بقية المشاريع — أي مجموعةٍ عليا ينتهي اسمها بـ "_tickets"
    //     (تشمل hail_tickets و bathroom001_tickets…). نستخدم متغيّر المجموعة الكامل
    //     مع شرط regex — Firestore لا يقبل خلط متغيّر بلاحقة في المقطع نفسه.
    match /{coll}/{doc} {
      allow read, update: if isSignedIn() && coll.matches('.*_tickets');
    }

    /* ─────────── سجل التدقيق ───────────
       ★ كان هنا بلوكٌ ثانٍ لـ`audit_log` يقول `allow read, write: if hasRole()`
       — و`write` تشمل التعديلَ والحذف. حُذف وانتقل حكمُه إلى البلوك المشدَّد أعلاه
       (M11). **وحذفُه شرطُ الإصلاح لا تنظيفاً**: القواعدُ تُقيَّم بـ«أو»، فبلوكٌ
       متساهلٌ باقٍ في أسفل الملفّ يُبطل التشديدَ في أعلاه بلا أن يظهر ذلك في أيّ
       سطر — ووقع ذلك فعلاً في أوّل تشغيلٍ لهذه الدفعة: خمسةُ فحوصٍ سقطت والقاعدةُ
       الجديدةُ مكتوبةٌ صحيحةً تماماً. */

    /* ═══════════════════════════════════════════════════════════════
       التعاقدات — الحارسُ على الخادم  (المرحلة ٦)

       كلُّ قيدٍ في `contracts.js` مكتوبٌ في المتصفّح: يمنع الخطأ ولا يمنع التعمّد.
       مَن يفتح أدوات المطوّر يكتب في القاعدة مباشرةً متجاوزاً كلَّ بوّابةِ اعتماد.
       فهذه القواعدُ تنقل **الأهمَّ** من تلك القيود إلى مكانٍ لا يملك المستخدمُ
       تعديلَه. وهي متعمَّدةُ التركيز: تحرس **مَن يحرّك الحالة** و**ما لا يُمَسّ**،
       ولا تعيد حسابَ الأرقام (رياضةُ المستخلص تبقى في الوحدة — قاعدةٌ تحاول محاكاةَ
       سُلَّمٍ ثمانيٍّ ستتفرّع عنه بصمتٍ عند أوّل تعديل).
       ═══════════════════════════════════════════════════════════════ */

    // ── سجلُّ الأطراف: الآيبان ناقلُ الاحتيال الأوّل، فله حارسُه ──
    function ibanOf(d) { return d.get(['bank','iban'], ''); }
    /* الإنشاءُ دائرةٌ أوسعُ من التعديل — والمشرفُ فيها (بلاغُ المالك):
       هو مَن يقف أمام المقاول في الموقع فأوّلُ من يعرف أنّ طرفاً جديداً دخل العمل،
       وحبسُ الإضافة في المشتريات يجعل الطرفَ يعمل قبل أن يوجد له سجلّ.
       **ويكتب معه الآيبانَ — عند الإنشاء وحدَه** (v18.9.2745، طلبُ المالك): يلقى
       المقاولَ ومعه بياناتُه البنكية فيسجّلها في السطر نفسِه بدل تمريرها للمالية.
       **والحدُّ مقصودٌ لأنّ الخطرَ في التبديل لا في الكتابة الأولى**: سيناريو
       الاحتيال هو تحويلُ مستحقِّ مقاولٍ قائمٍ إلى حسابٍ آخر — طرفٌ عمل شهوراً ثم
       يتغيّر آيبانُه قبل الصرف. أمّا الطرفُ الجديدُ فآيبانُه يُدخَل مرّةً مع بقيةِ
       بياناته ويمرّ على بوّابات الاعتماد كلِّها قبل أن يُصرف له ريال.
       فـ`vendorUpdateOk` لم تُمَسّ، و`vendorOwnUpdateOk` تُجمّد الآيبانَ صراحةً:
       **مَن يضيف لا يبدّل — ولا حتى ما أضافه هو.**
       ⚠ ومسؤولُ المشتريات ما زال ممنوعاً من كتابة الآيبان (لم يُطلَب توسيعُه):
       القائمةُ الثانيةُ تسمّي **مَن يكتب الآيبان** لا مَن يُنشئ الطرف.
       **وحدُّ هذه القاعدة معلَنٌ**: القواعدُ تقرأ الدورَ من التوكِن ولا تقرأ
       `permissions`، فإذنُ «التعاقدات» الفرديُّ يُطبَّق في الواجهة (`canAdd`)
       لا هنا. فالمشرفُ بلا إذنٍ لا يجد شاشةً يضيف منها، والقاعدةُ تحرس ما يهمّ
       فعلاً: **ألّا يُبدَّل آيبانٌ، وألّا يُمَسّ سجلٌّ قائم.**
       **والدورُ بصيغتيه**: المسجَّلُ من نافذة الإدارة «مشرف» بالعربية، وتوكِنُ تطبيق
       الفنيين يحمل `supervisor`. وقائمةٌ بإحداهما تردّ نصفَ المشرفين بلا سببٍ ظاهر. */
    function vendorCreateOk() {
      return anyRole(['procurement_officer','finance','admin','supervisor','مشرف'])
        && (ibanOf(request.resource.data) == ''
            || anyRole(['finance','admin','supervisor','مشرف']));
    }
    function vendorUpdateOk() {
      return anyRole(['procurement_officer','finance','admin'])
        && (ibanOf(request.resource.data) == ibanOf(resource.data) || anyRole(['finance','admin']));
    }
    /* ── المضيفُ يصحّح ما أضافه — ومِلكيّةٌ لا تُنتحَل ──
       المشرفُ يُنشئ طرفاً (`vendorCreateOk`)، فمن العبث أن يعجز عن تصحيح رقمِ سجلٍّ
       نقله خطأً في السطر التالي. لكنّ التصحيحَ **مقصورٌ على مستنده**، وأربعةُ قيودٍ
       تجعل ذلك محكَماً:
       • **المطابقةُ باسم الدخول** (`createdByUser` مقابل الادّعاء `u` في التوكِن) —
         لا بالاسم المعروض: الأسماءُ تتكرّر وتتغيّر، وهذه بوّابةُ كتابةٍ لا سطرُ عرض.
       • **ولا تُنتحَل المِلكيّة**: `createdByUser` و`createdBy` و`createdAt` في
         `unchanged` — فلا يكتب أحدٌ اسمَه على مستندِ غيره ثمّ يعدّله.
       • **ولا يُمَسّ الآيبان** (الشرطُ نفسُه الذي يحكم المشتريات).
       • **ولا الحالةُ** (`status`): الإيقافُ والحظرُ للأدمن، فلا يُلغيه المضيف.
       ونتيجتُه المعلَنة: طرفٌ بلا `createdByUser` (ما أُنشئ قبل هذا التغيير) لا
       يعدّله مشرفٌ أبداً — الشرطُ لا يجد ما يطابقه، وهو الوضعُ الآمن. */
    function vendorOwnUpdateOk() {
      return anyRole(['supervisor','مشرف'])
        && request.auth.token.get('u', '') != ''
        && resource.data.get('createdByUser', '') == request.auth.token.get('u', '')
        && ibanOf(request.resource.data) == ibanOf(resource.data)
        && unchanged(['createdByUser', 'createdBy', 'createdAt', 'status']);
    }
    match /global_vendors/{id} {
      allow read:   if hasRole();
      allow create: if vendorCreateOk();
      allow update: if vendorUpdateOk() || vendorOwnUpdateOk();
      allow delete: if isAdmin();
    }
    match /global_vendors_dev/{id} {
      allow read:   if hasRole();
      allow create: if vendorCreateOk();
      allow update: if vendorUpdateOk() || vendorOwnUpdateOk();
      allow delete: if isAdmin();
    }

    // ── طلباتُ التعاقد: البوّابةُ الحاليةُ هي مَن يملك تحريكَها ──
    // `crq_approved` ليست بوّابةَ اعتماد، لكنّها البابُ إلى إنشاء العقد — وهو
    // للمشتريات وحدَها، فتُعامَل معاملةَ البوّابة.
    function crqGate(st) {
      return st == 'crq_pending_pm'      ? ['project_manager','admin']
           : st == 'crq_pending_proc'    ? ['procurement_officer','admin']
           : st == 'crq_pending_finance' ? ['finance','admin']
           : st == 'crq_pending_ceo'     ? ['ceo','admin']
           : st == 'crq_pending_pay'     ? ['finance','admin']
           : st == 'crq_approved'        ? ['procurement_officer','admin']
           : ['admin'];
    }
    // `crqNextStage` بلا اعتمادٍ سابقٍ تُرجع البوّابةَ الأولى دائماً — فالطلبُ يولد
    // عندها بالضبط، لا عند أيّ بوّابةٍ لاحقةٍ يختارها المُنشئ
    function crqCreateOk() {
      return anyRole(['project_manager','admin'])
        && request.resource.data.status == 'crq_pending_pm';
    }
    /* **إلغاءُ التحويل** — الاستثناءُ الوحيدُ من «المحوَّلُ لا يُفتح» (v18.9.2588).
       حين يحذف الأدمنُ عقداً لم يُوقَّع، تُعيد المعاملةُ نفسُها طلبَه إلى «معتمَد»
       وتمسح `contractId` — وإلا بقي الطلبُ يشير إلى عقدٍ محذوف. وبلا هذا الاستثناء
       تُرفض المعاملةُ كلُّها (`permission-denied`) فيفشل الحذفُ رغم أن قاعدةَ حذف
       العقد تسمح به — وهو ما وقع فعلاً في الإنتاج وبلّغ عنه المالك.
       والبابُ **ضيّقٌ بأربعة شروطٍ معاً**: أدمن · من `crq_converted` وحدَها · إلى
       `crq_approved` بالضبط · وبمسح `contractId`. فلا يُفتح به المسدَّدُ ولا الملغى،
       ولا يُنقل المحوَّلُ إلى حالةٍ أخرى. */
    function crqUnconvertOk() {
      return isAdmin()
        && resource.data.status == 'crq_converted'
        && request.resource.data.status == 'crq_approved'
        && request.resource.data.get('contractId', '') == '';
    }
    function crqUpdateOk() {
      return anyRole(['project_manager','procurement_officer','finance','ceo','admin'])
        // الحالةُ النهائيةُ نهائية — لا تُفتح بعد إغلاقها، إلا إلغاءَ التحويل أعلاه
        && ( !(resource.data.status in ['crq_converted','crq_paid','crq_cancelled'])
             || crqUnconvertOk() )
        // طرفُ الطلب وشكلُه لا يتغيّران بعد الإرسال لأحدٍ كائناً من كان
        && unchanged(['createdAt','createdByUser','vendorId','engagement','projectId'])
        /* البنودُ والقيمةُ: مجمّدتان لكلّ دورٍ — **إلا الأدمن** (طلبُ المالك
           v18.9.2558). القاعدةُ الأصليةُ («وقّع المعتمِدُ على رقمٍ وسُدِّد غيرُه»)
           تبقى قائمةً لأن الوحدةَ تُسقط بصمةَ المالية عند تغيّر القيمة فيعود الطلبُ
           إلى بوّابتها — فالتعديلُ لا يمرّ على توقيعٍ قديم بل يُبطله. */
        && (unchanged(['value','lines']) || isAdmin())
        && ( request.resource.data.status == resource.data.status
             || request.resource.data.status == 'crq_cancelled'
             || anyRole(crqGate(resource.data.status)) );
    }
    // الحذفُ **للأدمن وعلى الملغى وحدَه** (طلبُ المالك v18.9.2553): الطلبُ الملغى
    // ورقةٌ ماتت قبل أن تُنتج أثراً — لا عقدَ ولا سداد — فحذفُها تنظيفٌ لا طمسٌ
    // لأثرٍ ماليّ. وما عداه لا يُحذف مهما كان الدور: المعتمَدُ والمحوَّلُ والمسدَّدُ
    // سجلٌّ ماليٌّ يُقرأ ولا يُمحى، والقيدُ في `audit` يبقى شاهداً على الحذف نفسِه.
    function crqDeleteOk() {
      return isAdmin() && resource.data.status == 'crq_cancelled';
    }
    match /global_contract_requests/{id} {
      allow read:   if hasRole();
      allow create: if crqCreateOk();
      allow update: if crqUpdateOk();
      allow delete: if crqDeleteOk();
    }
    match /global_contract_requests_dev/{id} {
      allow read:   if hasRole();
      allow create: if crqCreateOk();
      allow update: if crqUpdateOk();
      allow delete: if crqDeleteOk();
    }

    // ── العقود: جدولُ الانتقالات نفسُه الذي يحرس الأزرار ──
    function ctrTransitOk(from, to) {
      return (from == 'ctr_pending_signature' && to == 'ctr_active'
              && anyRole(['procurement_officer','project_manager','admin']))
          || (from == 'ctr_active'    && to == 'ctr_suspended' && anyRole(['project_manager','admin']))
          || (from == 'ctr_suspended' && to == 'ctr_active'    && anyRole(['project_manager','admin']))
          // الإنهاءُ الفنّيُّ بيد مدير المشروع — **وبيد المالية أيضاً**، لأنّ سدادَ
          // المستخلص الختاميّ يُنهي العقد في المعاملة نفسِها. قاعدةٌ تُغفل هذا
          // تُسقط السدادَ الأخير من كلّ عقدٍ في المنصة.
          || (from == 'ctr_active'    && to == 'ctr_completed' && anyRole(['project_manager','finance','admin']))
          || (from == 'ctr_completed' && to == 'ctr_closed'    && anyRole(['finance','admin']))
          || (to == 'ctr_terminated'
              && from in ['ctr_pending_signature','ctr_active','ctr_suspended'] && isAdmin());
    }
    function ctrCreateOk() {
      return anyRole(['procurement_officer','admin'])
        // لا عقدَ يولد سارياً — يولد بانتظار توقيع الطرف
        && request.resource.data.status == 'ctr_pending_signature';
    }
    function ctrUpdateOk() {
      return anyRole(['project_manager','procurement_officer','finance','ceo','admin'])
        && !(resource.data.status in ['ctr_closed','ctr_terminated'])
        && unchanged(['createdAt','requestId','vendorId','value','lines'])
        // `value` مجمَّدٌ أبداً: أوامرُ التغيير **تُضاف** في `changeOrders` ولا
        // تستبدله — فالتاريخُ يبقى والقيمةُ الحالية تُحسب. وتطبيقُ الأمر للمشتريات.
        && (unchanged(['changeOrders']) || anyRole(['procurement_officer','admin']))
        && ( request.resource.data.status == resource.data.status
             || ctrTransitOk(resource.data.status, request.resource.data.status) );
    }
    /* الحذفُ **للأدمن وعلى غير الموقَّع وحدَه** (طلبُ المالك v18.9.2587): العقدُ
       بين إنشائه وتوقيعِ الطرف لم يُنتج أثراً — والمستخلصُ وأمرُ التغيير لا يُنشآن
       إلا على عقدٍ **سارٍ** (يحرسه `extCreateOk`/`chgCreateOk` والكودُ معاً)، فحالةُ
       «بانتظار التوقيع» وحدَها ضمانةٌ كافيةٌ أنّ لا أبناءَ له. وما بعدها لا يُحذف
       مهما كان الدور: الساري يُفسَخ (`ctr_terminated`) ولا يُمحى. */
    function ctrDeleteOk() {
      return isAdmin() && resource.data.status == 'ctr_pending_signature';
    }
    match /global_contracts/{id} {
      allow read:   if hasRole();
      allow create: if ctrCreateOk();
      allow update: if ctrUpdateOk();
      allow delete: if ctrDeleteOk();
    }
    match /global_contracts_dev/{id} {
      allow read:   if hasRole();
      allow create: if ctrCreateOk();
      allow update: if ctrUpdateOk();
      allow delete: if ctrDeleteOk();
    }

    // ── المستخلصات: بوّابةٌ لكلّ حالة، والسدادُ لا يُسجَّل بلا إيصال ──
    function extGate(st) {
      return st == 'ext_pending_pm'      ? ['project_manager','admin']
           : st == 'ext_pending_ceo'     ? ['ceo','admin']
           : st == 'ext_pending_finance' ? ['finance','admin']
           : ['admin'];
    }
    function extCreateOk() {
      return anyRole(['project_manager','admin'])
        && request.resource.data.contractId is string
        && request.resource.data.contractId != ''
        && request.resource.data.status == 'ext_pending_pm';
    }
    function extUpdateOk() {
      return anyRole(['project_manager','ceo','finance','admin'])
        && !(resource.data.status in ['ext_paid','ext_cancelled'])
        // المستخلصُ لا يُنقل إلى عقدٍ آخر بعد إنشائه
        && unchanged(['createdAt','contractId'])
        && ( request.resource.data.status == resource.data.status
             || anyRole(extGate(resource.data.status)) )
        && ( request.resource.data.status != 'ext_paid'
             || ( anyRole(['finance','admin'])
                  && request.resource.data.get(['payment','receiptUrl'], '') != '' ) );
    }
    match /global_contract_extracts/{id} {
      allow read:   if hasRole();
      allow create: if extCreateOk();
      allow update: if extUpdateOk();
      allow delete: if false;
    }
    match /global_contract_extracts_dev/{id} {
      allow read:   if hasRole();
      allow create: if extCreateOk();
      allow update: if extUpdateOk();
      allow delete: if false;
    }

    // ── أوامرُ التغيير: أربعُ بوّاباتٍ، والتطبيقُ على العقد للمشتريات ──
    function chgGate(st) {
      return st == 'chg_pending_pm'      ? ['project_manager','admin']
           : st == 'chg_pending_proc'    ? ['procurement_officer','admin']
           : st == 'chg_pending_finance' ? ['finance','admin']
           : st == 'chg_pending_ceo'     ? ['ceo','admin']
           // `chg_approved` بابُ التطبيق على العقد — للمشتريات كإنشاء العقد نفسِه
           : st == 'chg_approved'        ? ['procurement_officer','admin']
           : ['admin'];
    }
    function chgCreateOk() {
      return anyRole(['project_manager','admin'])
        && request.resource.data.contractId is string
        && request.resource.data.contractId != ''
        // أمرٌ بلا سببٍ لا يُعتمَد — والسببُ جزءُ المستند لا تعليقٌ عليه
        && request.resource.data.reason is string
        && request.resource.data.reason != ''
        && request.resource.data.status == 'chg_pending_pm';
    }
    function chgUpdateOk() {
      return anyRole(['project_manager','procurement_officer','finance','ceo','admin'])
        && !(resource.data.status in ['chg_applied','chg_rejected','chg_cancelled'])
        // أثرُ الأمر وبنودُه لا تتغيّر بعد الإرسال: وإلا اعتُمد رقمٌ وطُبِّق غيرُه
        && unchanged(['createdAt','createdByUser','contractId','amount','lines','durationDaysDelta'])
        && ( request.resource.data.status == resource.data.status
             || request.resource.data.status == 'chg_cancelled'
             || anyRole(chgGate(resource.data.status)) );
    }
    match /global_contract_changes/{id} {
      allow read:   if hasRole();
      allow create: if chgCreateOk();
      allow update: if chgUpdateOk();
      allow delete: if false;
    }
    match /global_contract_changes_dev/{id} {
      allow read:   if hasRole();
      allow create: if chgCreateOk();
      allow update: if chgUpdateOk();
      allow delete: if false;
    }
  }
}
